{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/afsd/run-manifest.schema.json",
  "title": "AFSD output run manifest",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "run_classification",
    "physics_claims_allowed",
    "created_utc",
    "status",
    "backend",
    "configuration",
    "units",
    "coordinate_frames",
    "particles",
    "provenance"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "run_classification": {
      "enum": ["GEOMETRY_FIXTURE", "DEBUG", "APPROXIMATE", "PAPER_COMPARISON"]
    },
    "physics_claims_allowed": { "type": "boolean" },
    "created_utc": { "type": "string", "format": "date-time" },
    "status": { "enum": ["COMPLETE", "INCOMPLETE", "FAILED", "BLOCKED"] },
    "backend": {
      "type": "object",
      "required": ["name", "repository", "commit", "dirty", "compiler", "build_mode"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "repository": { "type": ["string", "null"] },
        "commit": { "type": ["string", "null"] },
        "dirty": { "type": ["boolean", "null"] },
        "compiler": { "type": ["string", "null"] },
        "build_mode": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "configuration": {
      "type": "object",
      "required": ["case_id", "path", "sha256"],
      "properties": {
        "case_id": { "type": ["string", "null"] },
        "path": { "type": ["string", "null"] },
        "sha256": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "units": {
      "type": "object",
      "required": ["calculation_system", "length", "time", "mass", "temperature", "stress"],
      "properties": {
        "calculation_system": { "const": "SI" },
        "length": { "const": "m" },
        "time": { "const": "s" },
        "mass": { "const": "kg" },
        "temperature": { "const": "K" },
        "stress": { "const": "Pa" }
      },
      "additionalProperties": true
    },
    "coordinate_frames": {
      "type": "object",
      "required": ["stored_frame", "definition"],
      "properties": {
        "stored_frame": { "type": "string", "minLength": 1 },
        "definition": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "particles": {
      "type": "object",
      "required": [
        "file",
        "format",
        "sha256",
        "count",
        "persistent_id_field",
        "initial_position_field",
        "material_id_field",
        "tracer_type_field",
        "fields"
      ],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "format": { "enum": ["VTK_LEGACY_ASCII", "VTU", "HDF5"] },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "count": { "type": "integer", "minimum": 0 },
        "persistent_id_field": { "const": "particle_id" },
        "initial_position_field": { "const": "initial_position_m" },
        "material_id_field": { "const": "material_id" },
        "tracer_type_field": { "const": "tracer_type" },
        "fields": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "required": ["command", "logs", "source_files", "approximations"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "logs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "source_files": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "approximations": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": { "run_classification": { "const": "GEOMETRY_FIXTURE" } },
        "required": ["run_classification"]
      },
      "then": { "properties": { "physics_claims_allowed": { "const": false } } }
    },
    {
      "if": {
        "properties": {
          "run_classification": {
            "enum": ["DEBUG", "APPROXIMATE", "PAPER_COMPARISON"]
          }
        },
        "required": ["run_classification"]
      },
      "then": {
        "properties": {
          "backend": {
            "properties": {
              "repository": { "type": "string", "minLength": 1 },
              "commit": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
              "dirty": { "type": "boolean" },
              "compiler": { "type": "string", "minLength": 1 },
              "build_mode": { "type": "string", "minLength": 1 }
            }
          },
          "configuration": {
            "properties": {
              "case_id": { "type": "string", "minLength": 1 },
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          },
          "provenance": {
            "properties": {
              "logs": { "minItems": 1 },
              "source_files": { "minItems": 1 }
            }
          }
        }
      }
    }
  ]
}

